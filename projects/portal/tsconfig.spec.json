{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/spec",
    "types": ["jasmine", "node"],
    "skipLibCheck": true
  },
  "files": ["src/test.ts"],
  "include": [
    "src/app/search/**/*.spec.ts",
    "src/app/shared/**/*.spec.ts",
    "src/app/documentation/*.spec.ts",
    "src/app/guide/*.spec.ts",
    "src/**/*.d.ts"
  ],
  "angularCompilerOptions": {
    "strictTemplates": false
  }
}
